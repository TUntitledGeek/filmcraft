@@ -0,0 +1,138 @@
+//! Optional shared-memory application artifact. No custom browser or browser flags are needed.
+use std::path::Path;
+use std::process::Command;
+
+const TOOLCHAIN: &str = "nightly-2026-10-28";
+
+pub fn tree_bytes(root: &Path) -> Result<u64, String> {
+    let mut pending = vec![(root.to_path_buf(), 0)];
+    let mut bytes = 0u64;
+    while let Some((path, depth)) = pending.pop() {
+        if depth > 12 {
+            return Err("web artifact directory is too deeply nested".into());
+        }
+        let metadata = std::fs::symlink_metadata(&path).map_err(|error| error.to_string())?;
+        if metadata.is_file() {
+            bytes = bytes.saturating_add(metadata.len());
+        } else if metadata.is_dir() {
+            for entry in std::fs::read_dir(path).map_err(|error| error.to_string())? {
+                pending.push((entry.map_err(|error| error.to_string())?.path(), depth + 1));
+            }
+        }
+    }
+    Ok(bytes)
+}
+
+fn flags(existing: &str) -> String {
+    let mut flags = existing.to_string();
+    let mut push = |arg: &str| {
+        if !flags.is_empty() {
+            flags.push('\u{1f}');
+        }
+        flags.push_str(arg);
+    };
+    // An encoded override supersedes .cargo/config.toml, so retain its required backend cfg.
+    push("--cfg");
+    push("getrandom_backend=\"wasm_js\"");
+    push("-C");
+    push("target-feature=+atomics,+bulk-memory,+mutable-globals,+simd128");
+    for arg in [
+        "--import-memory",
+        "--export-memory",
+        "--shared-memory",
+        "--initial-memory=67108864",
+        "--max-memory=2147483648",
+        "--export=__wasm_init_tls",
+        "--export=__tls_size",
+        "--export=__tls_align",
+        "--export=__tls_base",
+    ] {
+        push("-C");
+        push(&format!("link-arg={arg}"));
+    }
+    flags
+}
+
+pub fn build(dist: &Path, target: &Path, dir: &str, profile: &str, dev: bool) -> Result<String, String> {
+    let mt_target = target.join("web-mt");
+    let mut command = Command::new("rustup");
+    command.args([
+        "run",
+        TOOLCHAIN,
+        "cargo",
+        "build",
+        "-Z",
+        "build-std=std,panic_abort",
+        "--target",
+        "wasm32-unknown-unknown",
+        "-p",
+        "filmcraft-web",
+        "--features",
+        "threads",
+        "--locked",
+        "--profile",
+        profile,
+    ]);
+    // A caller may place stable's real binaries ahead of rustup's shims in PATH.
+    // Resolve this compiler explicitly so build-std cannot mix compiler and std sources.
+    let compiler =
+        Command::new("rustup").args(["which", "--toolchain", TOOLCHAIN, "rustc"]).output().map_err(|error| format!("locate {TOOLCHAIN} compiler: {error}"))?;
+    if !compiler.status.success() {
+        return Err(format!("{TOOLCHAIN} compiler is unavailable: {}", String::from_utf8_lossy(&compiler.stderr)));
+    }
+    let compiler = String::from_utf8(compiler.stdout).map_err(|error| error.to_string())?;
+    command.env("RUSTC", compiler.trim()).env_remove("RUSTDOC").env("RUSTUP_TOOLCHAIN", TOOLCHAIN);
+    command.env("CARGO_TARGET_DIR", &mt_target);
+    command.env("CARGO_ENCODED_RUSTFLAGS", flags(&std::env::var("CARGO_ENCODED_RUSTFLAGS").unwrap_or_default()));
+    super::run(&mut command).map_err(|error| format!("optional threaded build ({TOOLCHAIN} + rust-src required): {error}"))?;
+    let mt = dist.join("mt");
+    std::fs::create_dir_all(&mt).map_err(|error| error.to_string())?;
+    let wasm = mt_target.join("wasm32-unknown-unknown").join(dir).join("filmcraft_web.wasm");
+    super::run(Command::new("wasm-bindgen").args(["--target", "web", "--no-typescript", "--out-dir"]).arg(&mt).arg(wasm))?;
+    let bg = mt.join("filmcraft_web_bg.wasm");
+    if !dev && Command::new("wasm-opt").arg("--version").output().is_ok() {
+        let optimized = mt.join("filmcraft_web_opt.wasm");
+        super::run(
+            Command::new("wasm-opt")
+                .args([
+                    "-O2",
+                    "--enable-bulk-memory",
+                    "--enable-nontrapping-float-to-int",
+                    "--enable-sign-ext",
+                    "--enable-mutable-globals",
+                    "--enable-simd",
+                    "--enable-threads",
+                ])
+                .arg(&bg)
+                .arg("-o")
+                .arg(&optimized),
+        )?;
+        std::fs::rename(optimized, &bg).map_err(|error| error.to_string())?;
+    }
+    let mut hash = 0xcbf2_9ce4_8422_2325u64;
+    for file in [mt.join("filmcraft_web.js"), bg] {
+        for byte in std::fs::read(file).map_err(|error| error.to_string())? {
+            hash = (hash ^ u64::from(byte)).wrapping_mul(0x100_0000_01b3);
+        }
+    }
+    Ok(format!("{hash:016x}"))
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn atomics_build_keeps_caller_flags_and_required_browser_backend() {
+        let flags = super::flags("--cfg\u{1f}caller_setting");
+        assert!(flags.starts_with("--cfg\u{1f}caller_setting\u{1f}"));
+        for arg in [
+            "getrandom_backend=\"wasm_js\"",
+            "link-arg=--shared-memory",
+            "link-arg=--import-memory",
+            "link-arg=--max-memory=2147483648",
+            "link-arg=--export=__wasm_init_tls",
+        ] {
+            assert!(flags.split('\u{1f}').any(|flag| flag == arg), "missing {arg}");
+        }
+        assert!(!flags.starts_with('\u{1f}'));
+    }
+}
